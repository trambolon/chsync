<!--
  admin / 123456qwe — доступ отовсюду, с управлением доступом (SQL RBAC).
  default — без пароля, но только с localhost внутри контейнера (healthcheck).
  Хеш пароля: echo -n '123456qwe' | sha256sum
-->
<clickhouse>
    <users>
        <admin>
            <password_sha256_hex>60b40b7846a7afe973ce089f19068cffc53e40fe28cd076f937c644f6127aad6</password_sha256_hex>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </admin>
        <default>
            <networks replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>
    </users>
</clickhouse>
